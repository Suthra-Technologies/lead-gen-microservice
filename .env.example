# -------------------------------------------------------------
# Crawler Environment Variables
# Copy to .env and adjust values as needed
# -------------------------------------------------------------

# Reddit API Credentials (for PRAW integration when ready)
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=SolarLeadDiscoveryBot/1.0 (by /u/your_username)

# Crawler Settings
CRAWLER_MAX_CONCURRENCY=8
CRAWLER_POLITENESS_DELAY=1.5
CRAWLER_TIMEOUT=12

# Database Connection (Default: SQLite local, upgrade to PostgreSQL as you scale)
DATABASE_URL=sqlite:///data/crawler_storage.db
# DATABASE_URL=postgresql://user:password@localhost:5432/solar_crawler

